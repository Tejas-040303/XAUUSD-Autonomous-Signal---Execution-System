# Copy to .env (gitignored) and fill in. NEVER commit the real file, and never
# paste these values into a chat or an issue — this repository is public.

# --- Reading the signal channel (MTProto, your user account) ---------------
# From https://my.telegram.org -> API development tools.
#
# A bot CANNOT do this job: a bot only sees chats it has been added to, you
# cannot add your bot to someone else's VIP channel, and the Bot API has no
# method to fetch past messages at all — which spec §28's history backfill
# requires. So the reading side is a user account.
#
# Strongly prefer a SEPARATE Telegram account that has joined the signal
# channel, not your main one: automated history reading gets accounts
# rate-limited and occasionally banned, and the .session file this produces is
# a full-account credential that bypasses the account password and 2FA.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Sending status updates (Bot API, from @BotFather) --------------------
# Separate credential on purpose. If this leaks, the damage is bounded to
# "someone can post in your status chat" — not account takeover.
# Revoke and reissue via @BotFather -> /mybots -> API Token -> Revoke.
TELEGRAM_BOT_TOKEN=

# --- MT5 (P3 only; not needed for the archiver) ---------------------------
# The master password grants full trading control from any terminal. MT5 has
# no scoped API keys, so treat this as the highest-value secret here.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# --- Vision parser (P1 only) ----------------------------------------------
ANTHROPIC_API_KEY=
